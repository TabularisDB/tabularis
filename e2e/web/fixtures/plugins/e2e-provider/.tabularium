{
  "name": "e2e-provider",
  "version": "1.0.0",
  "description": "Deterministic provider sandbox fixture.",
  "default_port": null,
  "executable": "driver.py",
  "interpreter": "python3",
  "default_username": "",
  "color": "#7c3aed",
  "icon": "database",
  "capabilities": {
    "schemas": false,
    "views": false,
    "routines": false,
    "file_based": false,
    "folder_based": false,
    "connection_string": false,
    "identifier_quote": "\"",
    "sql_dialect": "generic",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "no_connection_required": true,
    "manage_tables": false,
    "readonly": true
  },
  "data_types": [
    {
      "name": "TEXT",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    }
  ],
  "kind": "cloud",
  "ui_extensions": [
    {
      "slot": "connections.actions",
      "module": "ui/provider.js",
      "api_version": "0.4.1"
    },
    {
      "slot": "explorer.services",
      "module": "ui/provider.js",
      "api_version": "0.4.1"
    },
    {
      "slot": "editor.workspace.content",
      "module": "ui/provider.js",
      "api_version": "0.4.1"
    },
    {
      "slot": "connection-modal.setup",
      "module": "ui/provider.js",
      "api_version": "0.4.1"
    }
  ]
}
