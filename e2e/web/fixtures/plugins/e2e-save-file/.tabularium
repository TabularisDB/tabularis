{
  "name": "e2e-save-file",
  "version": "1.0.0",
  "description": "Sandboxed UI extension that saves a file through the host.",
  "default_port": null,
  "default_username": "",
  "color": "#2563eb",
  "icon": "download",
  "capabilities": {
    "schemas": false,
    "views": false,
    "routines": false,
    "file_based": false,
    "folder_based": false,
    "connection_string": false,
    "identifier_quote": "\"",
    "sql_dialect": "generic",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "no_connection_required": true,
    "manage_tables": false,
    "readonly": true
  },
  "data_types": [],
  "ui_extensions": [
    {
      "slot": "connections.actions",
      "module": "ui/save-file.js",
      "api_version": "0.4.2",
      "order": 1
    }
  ]
}
