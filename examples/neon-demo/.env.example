# All values stay on the server. Do not add NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://AUTH_HOST/neondb/auth/jwks
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEON_AUTH_COOKIE_SECRET=
NEON_REALTIME_URL=wss://REALTIME_HOST
NEON_REALTIME_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://STORAGE_HOST
AWS_REGION=eu-central-1
NEON_STORAGE_BUCKET=assets
NEON_AI_GATEWAY_BASE_URL=https://GATEWAY_HOST
NEON_AI_GATEWAY_TOKEN=
NEON_AI_MODEL=claude-haiku-4-5
NEON_FUNCTION_DEMO_BASE_URL=https://FUNCTION_HOST
APP_ORIGIN=http://127.0.0.1:3008
