{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Declarative Tabularis AI assistant package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "description",
    "kind",
    "ai_assistant"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "kind": {
      "const": "ai-assistant"
    },
    "min_runtime_version": {
      "type": "string"
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "select"
            ]
          },
          "default": {},
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    },
    "ai_assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "authentication",
        "generate",
        "models"
      ],
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "authentication": {
          "type": "string",
          "enum": [
            "api-key",
            "none"
          ]
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "maxLength": 100
        },
        "default_models": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "optional_api_key": {
          "type": "boolean"
        },
        "api_key_header": {
          "type": "string",
          "maxLength": 100
        },
        "api_key_prefix": {
          "type": "string",
          "maxLength": 100
        },
        "direct": {
          "type": "boolean"
        },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "response"
          ],
          "properties": {
            "requests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "append_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "headers": {
                    "type": "object",
                    "maxProperties": 16,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  },
                  "body": {
                    "type": "object"
                  },
                  "authenticated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 2048
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "equals": {},
                    "contains": {},
                    "starts_with": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "missing_matches": {
                      "type": "boolean"
                    },
                    "prefixes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  }
                },
                "value_path": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "items_path",
                  "id_path"
                ],
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "append_path": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "headers": {
                        "type": "object",
                        "maxProperties": 16,
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2048
                        }
                      },
                      "body": {
                        "type": "object"
                      },
                      "authenticated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "items_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "id_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "filters": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "equals": {},
                        "contains": {},
                        "starts_with": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "missing_matches": {
                          "type": "boolean"
                        },
                        "prefixes": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "maxLength": 100
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "cache_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "fallback": {
              "type": "boolean"
            }
          }
        },
        "auto_select_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "homepage": {
      "type": "string",
      "maxLength": 2048
    },
    "license": {
      "type": "string",
      "maxLength": 2048
    },
    "icon": {
      "type": "string",
      "maxLength": 2048
    },
    "author": {
      "type": "string",
      "maxLength": 2048
    },
    "$schema": {
      "type": "string"
    }
  }
}
