{
  "id": "api-route",
  "name": "API Route",
  "version": "1.0.0",
  "kind": "ai-assistant",
  "description": "API Route assistant for Tabularis.",
  "settings": [],
  "ai_assistant": {
    "api_version": 1,
    "authentication": "api-key",
    "api_key_env": "API_ROUTE_API_KEY",
    "default_models": [],
    "require_explicit_model": true,
    "generate": {
      "requests": [
        {
          "url": "https://global.api-route.com/v1",
          "append_path": "/chat/completions",
          "body": {
            "model": "{{model}}",
            "messages": [
              {
                "role": "system",
                "content": "{{system_prompt}}"
              },
              {
                "role": "user",
                "content": "{{prompt}}"
              }
            ],
            "temperature": 0
          }
        }
      ],
      "response": {
        "path": "/choices/0/message/content"
      }
    },
    "models": {
      "sources": [
        {
          "request": {
            "url": "https://global.api-route.com/v1",
            "append_path": "/models"
          },
          "items_path": "/data",
          "id_path": "/id"
        }
      ],
      "cache_seconds": 0
    }
  },
  "license": "Apache-2.0",
  "icon": "data:image/svg+xml;base64,"
}
