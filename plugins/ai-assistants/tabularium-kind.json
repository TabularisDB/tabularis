{
  "key": "ai-assistant",
  "label": "AI assistants",
  "labelTranslations": {
    "it": "Assistenti AI"
  },
  "description": "Declarative AI providers for Tabularis. No plugin code is executed.",
  "publicPageEnabled": true,
  "publicPageCopy": {
    "hero": "Choose your AI assistant",
    "intro": "Use the providers built into Tabularis, or install additional providers such as Gemini. Credentials and settings stay in the application; external packages can be updated independently."
  },
  "extensionsSchema": {
    "ai_assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": true,
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "authentication": {
          "type": "string",
          "enum": ["api-key", "none"]
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "maxLength": 100
        },
        "default_models": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "optional_api_key": {
          "type": "boolean"
        },
        "api_key_header": {
          "type": "string",
          "maxLength": 100
        },
        "api_key_prefix": {
          "type": "string",
          "maxLength": 100
        },
        "direct": {
          "type": "boolean"
        },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "response"],
          "properties": {
            "requests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "append_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "headers": {
                    "type": "object",
                    "maxProperties": 16,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  },
                  "body": {
                    "type": "object"
                  },
                  "authenticated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 2048
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "equals": {},
                    "contains": {},
                    "starts_with": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "missing_matches": {
                      "type": "boolean"
                    },
                    "prefixes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  }
                },
                "value_path": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sources"],
          "properties": {
            "sources": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["request", "items_path", "id_path"],
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url"],
                    "properties": {
                      "url": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "append_path": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "headers": {
                        "type": "object",
                        "maxProperties": 16,
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2048
                        }
                      },
                      "body": {
                        "type": "object"
                      },
                      "authenticated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "items_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "id_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "filters": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["path"],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "equals": {},
                        "contains": {},
                        "starts_with": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "missing_matches": {
                          "type": "boolean"
                        },
                        "prefixes": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "maxLength": 100
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "cache_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "fallback": {
              "type": "boolean"
            }
          }
        },
        "auto_select_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "require_explicit_model": {
          "type": "boolean",
          "default": false,
          "description": "Require a saved or explicitly selected model instead of choosing the first discovered model."
        }
      },
      "allOf": [
        {
          "required": ["api_version", "authentication", "generate", "models"]
        }
      ]
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "select"]
          },
          "default": {},
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    }
  },
  "customExample": {
    "json": "{\n  \"id\": \"gemini\",\n  \"name\": \"Google Gemini\",\n  \"version\": \"1.0.1\",\n  \"kind\": \"ai-assistant\",\n  \"description\": \"Google Gemini assistant using the native generateContent API.\",\n  \"ai_assistant\": {\n    \"api_version\": 1,\n    \"authentication\": \"api-key\",\n    \"api_key_env\": \"GEMINI_API_KEY\",\n    \"api_key_header\": \"x-goog-api-key\",\n    \"api_key_prefix\": \"\",\n    \"default_models\": [\n      \"models/gemini-flash-latest\"\n    ],\n    \"generate\": {\n      \"requests\": [\n        {\n          \"url\": \"https://generativelanguage.googleapis.com/v1beta/{{model}}:generateContent\",\n          \"body\": {\n            \"systemInstruction\": {\n              \"parts\": [\n                {\n                  \"text\": \"{{system_prompt}}\"\n                }\n              ]\n            },\n            \"contents\": [\n              {\n                \"role\": \"user\",\n                \"parts\": [\n                  {\n                    \"text\": \"{{prompt}}\"\n                  }\n                ]\n              }\n            ]\n          }\n        }\n      ],\n      \"response\": {\n        \"path\": \"/candidates/0/content/parts\",\n        \"select\": {\n          \"path\": \"/thought\",\n          \"equals\": false,\n          \"missing_matches\": true\n        },\n        \"value_path\": \"/text\"\n      }\n    },\n    \"models\": {\n      \"sources\": [\n        {\n          \"request\": {\n            \"url\": \"https://generativelanguage.googleapis.com/v1beta/models\"\n          },\n          \"items_path\": \"/models\",\n          \"id_path\": \"/name\",\n          \"filters\": [\n            {\n              \"path\": \"/supportedGenerationMethods\",\n              \"contains\": \"generateContent\"\n            }\n          ]\n        }\n      ],\n      \"cache_seconds\": 86400\n    }\n  },\n  \"settings\": [],\n  \"license\": \"Apache-2.0\",\n  \"icon\": \"https://raw.githubusercontent.com/TabularisDB/tabularis-gemini-plugin/main/icon.svg\"\n}"
  }
}
