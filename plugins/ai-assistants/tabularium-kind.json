{
  "key": "ai-assistant",
  "label": "AI assistants",
  "labelTranslations": {
    "it": "Assistenti AI"
  },
  "description": "Declarative AI providers for Tabularis. No plugin code is executed.",
  "publicPageEnabled": true,
  "publicPageCopy": {
    "hero": "Choose your AI assistant",
    "intro": "Install the providers you use, configure credentials in Tabularis, and keep provider definitions up to date independently."
  },
  "extensionsSchema": {
    "ai_assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": true,
      "properties": {
        "api_version": {
          "type": "integer",
          "const": 1
        },
        "authentication": {
          "type": "string",
          "enum": [
            "api-key",
            "none"
          ]
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$",
          "maxLength": 100
        },
        "default_models": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "optional_api_key": {
          "type": "boolean"
        },
        "api_key_header": {
          "type": "string",
          "maxLength": 100
        },
        "api_key_prefix": {
          "type": "string",
          "maxLength": 100
        },
        "direct": {
          "type": "boolean"
        },
        "generate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "response"
          ],
          "properties": {
            "requests": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "append_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "headers": {
                    "type": "object",
                    "maxProperties": 16,
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 2048
                    }
                  },
                  "body": {
                    "type": "object"
                  },
                  "authenticated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 2048
                },
                "select": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "equals": {},
                    "contains": {},
                    "starts_with": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "missing_matches": {
                      "type": "boolean"
                    },
                    "prefixes": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "maxLength": 100
                      }
                    }
                  }
                },
                "value_path": {
                  "type": "string",
                  "maxLength": 2048
                }
              }
            }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources"
          ],
          "properties": {
            "sources": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "request",
                  "items_path",
                  "id_path"
                ],
                "properties": {
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "url"
                    ],
                    "properties": {
                      "url": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "append_path": {
                        "type": "string",
                        "maxLength": 2048
                      },
                      "headers": {
                        "type": "object",
                        "maxProperties": 16,
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 2048
                        }
                      },
                      "body": {
                        "type": "object"
                      },
                      "authenticated": {
                        "type": "boolean"
                      }
                    }
                  },
                  "items_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "id_path": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "filters": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "equals": {},
                        "contains": {},
                        "starts_with": {
                          "type": "string",
                          "maxLength": 256
                        },
                        "missing_matches": {
                          "type": "boolean"
                        },
                        "prefixes": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "string",
                            "maxLength": 100
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "cache_seconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400
            },
            "fallback": {
              "type": "boolean"
            }
          }
        },
        "auto_select_priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "allOf": [
        {
          "required": [
            "api_version",
            "authentication",
            "generate",
            "models"
          ]
        }
      ]
    },
    "settings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "type"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 2048
          },
          "description": {
            "type": "string",
            "maxLength": 2048
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "select"
            ]
          },
          "default": {},
          "required": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    }
  },
  "customExample": {
    "json": "{\n  \"id\": \"runcrate\",\n  \"name\": \"Runcrate\",\n  \"version\": \"1.0.0\",\n  \"kind\": \"ai-assistant\",\n  \"description\": \"Runcrate AI assistant for Tabularis.\",\n  \"settings\": [],\n  \"ai_assistant\": {\n    \"api_version\": 1,\n    \"authentication\": \"api-key\",\n    \"api_key_env\": \"RUNCRATE_API_KEY\",\n    \"default_models\": [\n      \"deepseek-ai/DeepSeek-V4.1-Flash\",\n      \"zai-org/GLM-5.3-Flash\",\n      \"zai-org/GLM-5.3\",\n      \"Qwen/Qwen3.8-Flash\",\n      \"openai/gpt-oss-120b\",\n      \"moonshotai/Kimi-K2.6\"\n    ],\n    \"generate\": {\n      \"requests\": [\n        {\n          \"url\": \"https://api.runcrate.ai/v1\",\n          \"body\": {\n            \"model\": \"{{model}}\",\n            \"messages\": [\n              {\n                \"role\": \"system\",\n                \"content\": \"{{system_prompt}}\"\n              },\n              {\n                \"role\": \"user\",\n                \"content\": \"{{prompt}}\"\n              }\n            ],\n            \"temperature\": 0.0\n          },\n          \"append_path\": \"/chat/completions\"\n        }\n      ],\n      \"response\": {\n        \"path\": \"/choices/0/message/content\"\n      }\n    },\n    \"models\": {\n      \"sources\": [\n        {\n          \"request\": {\n            \"url\": \"https://api.runcrate.ai/v1\",\n            \"append_path\": \"/models\",\n            \"authenticated\": false\n          },\n          \"items_path\": \"/data\",\n          \"id_path\": \"/id\",\n          \"filters\": [\n            {\n              \"path\": \"/output_modalities\",\n              \"contains\": \"text\"\n            }\n          ]\n        }\n      ],\n      \"cache_seconds\": 86400\n    }\n  },\n  \"license\": \"Apache-2.0\"\n}\n"
  }
}
