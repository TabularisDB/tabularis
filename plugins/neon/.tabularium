{
  "id": "neon",
  "name": "Neon",
  "version": "0.2.0",
  "description": "Preview Neon workspace: PostgreSQL, branches, Auth, Storage, Functions, Realtime and AI Gateway. Requires the provider-workspace Core build.",
  "default_port": 5432,
  "default_username": "",
  "executable": "dist/driver.js",
  "capabilities": {
    "schemas": true,
    "views": true,
    "routines": true,
    "file_based": false,
    "folder_based": false,
    "no_connection_required": false,
    "identifier_quote": "\"",
    "alter_primary_key": false,
    "alter_column": false,
    "create_foreign_keys": false,
    "manage_tables": false,
    "readonly": false,
    "connection_string": false,
    "supports_ssl": true,
    "sql_dialect": "postgres",
    "explain": true
  },
  "data_types": [
    {
      "name": "INTEGER",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BIGINT",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "NUMERIC",
      "category": "numeric",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TEXT",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BOOLEAN",
      "category": "other",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "UUID",
      "category": "string",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "TIMESTAMPTZ",
      "category": "date",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "JSONB",
      "category": "json",
      "requires_length": false,
      "requires_precision": false
    },
    {
      "name": "BYTEA",
      "category": "binary",
      "requires_length": false,
      "requires_precision": false
    }
  ],
  "interpreter": "node",
  "color": "#00e599",
  "icon": "https://raw.githubusercontent.com/NewtTheWolf/tabularis-neon-plugin/v0.2.0/assets/icon.svg",
  "engine": "neon",
  "ui_extensions": [
    {
      "slot": "connection-modal.setup",
      "module": "ui/dist/index.js",
      "driver": "neon",
      "order": 30,
      "api_version": "0.2.7"
    },
    {
      "slot": "explorer.services",
      "module": "ui/dist/index.js",
      "driver": "neon",
      "order": 30,
      "api_version": "0.2.7"
    },
    {
      "slot": "settings.plugin.actions",
      "module": "ui/dist/index.js",
      "order": 30,
      "api_version": "0.2.7"
    },
    {
      "slot": "editor.workspace.content",
      "module": "ui/dist/workspace.js",
      "driver": "neon",
      "order": 30,
      "api_version": "0.2.7"
    },
    {
      "slot": "explorer.connection.actions",
      "module": "ui/dist/branch-selector.js",
      "driver": "neon",
      "order": 30,
      "api_version": "0.2.7"
    }
  ],
  "kind": "driver",
  "paradigms": [
    "sql"
  ],
  "min_runtime_version": "0.31.0",
  "category": "database",
  "tags": [
    "neon",
    "postgresql",
    "serverless",
    "auth",
    "storage",
    "functions",
    "realtime",
    "ai",
    "preview"
  ],
  "license": "Apache-2.0",
  "readme": "README.md",
  "homepage": "https://github.com/NewtTheWolf/tabularis-neon-plugin",
  "support": {
    "issues_url": "https://github.com/NewtTheWolf/tabularis-neon-plugin/issues"
  },
  "screenshots": [
    {
      "url": "screenshots/overview.png",
      "caption": "Actual Tabularis integration-test capture: native Explorer and service overview. Preview Core build required.",
      "alt": "Neon services in the native Tabularis Explorer and overview tab"
    },
    {
      "url": "screenshots/functions.png",
      "caption": "Actual Function editor with disposable test source. Redeployment activation remains a known live-test failure.",
      "alt": "Monaco JavaScript Function editor and deployment controls"
    },
    {
      "url": "screenshots/storage.png",
      "caption": "Actual Storage test capture with disposable text content and confirmed object deletion.",
      "alt": "Private assets bucket browser and text object controls"
    },
    {
      "url": "screenshots/ai-gateway.png",
      "caption": "Actual AI Gateway test capture with a synthetic prompt and response.",
      "alt": "Model selection and a test AI Gateway response"
    }
  ]
}
