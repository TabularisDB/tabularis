{
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6",
    "@neon/realtime": "^0.1.2",
    "@neon/sdk": "7.6.1",
    "@tabularis/explain": "^0.2.0",
    "dotenv": "^18.0.9",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "name": "tabularis-neon-plugin",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm build:runtime && pnpm build:ui",
    "start": "node dist/driver.js",
    "test": "node --test tests/unit.mjs tests/account.mjs tests/management.mjs tests/cli-auth.mjs tests/branches.mjs tests/usage.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:runtime": "tsc -p tsconfig.json",
    "build:ui": "pnpm --dir ui build",
    "test:scoped": "node tests/scoped.mjs",
    "dev:setup": "node scripts/setup-development.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "test:host": "node tests/host-e2e.mjs"
  }
}
