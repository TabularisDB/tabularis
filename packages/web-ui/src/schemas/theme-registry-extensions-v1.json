{
  "theme_schema_version": {
    "type": "integer",
    "const": 1,
    "required": true
  },
  "theme_variants": {
    "type": "array",
    "minItems": 1,
    "maxItems": 32,
    "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])$)[a-z][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "file": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^themes/(?:[A-Za-z0-9][A-Za-z0-9._-]*/){0,6}[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
        }
      },
      "required": [
        "id",
        "name",
        "file"
      ]
    },
    "required": true
  }
}
