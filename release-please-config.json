{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "bootstrap-sha": "cbc7d587a7bd3fcdfd18c214924f20cadec3109f",
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "include-component-in-tag": true,
  "packages": {
    "packages/create-plugin": {
      "release-type": "node",
      "component": "create-plugin",
      "pull-request-title-pattern": "chore(create-plugin): release ${version}"
    },
    "packages/explain": {
      "release-type": "node",
      "component": "explain",
      "pull-request-title-pattern": "chore(explain): release ${version}"
    },
    "packages/plugin-api": {
      "release-type": "node",
      "component": "plugin-api",
      "pull-request-title-pattern": "chore(plugin-api): release ${version}"
    }
  }
}
